{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "serviceNowInfrastructure": {
      "type": "object",
      "properties": {
        "bridgeUrl": {
          "type": "string"
        },
        "bridgeToken": {
          "type": "string",
          "visibility": "secret"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "visibility": "frontend"
        }
      },
      "required": [
        "bridgeUrl",
        "bridgeToken",
        "entities"
      ]
    }
  }
}