{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "vaultHealth": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entityRef", "bindingKey", "reportFile"],
            "properties": {
              "entityRef": { "type": "string" },
              "bindingKey": { "type": "string" },
              "reportFile": { "type": "string" }
            }
          }
        }
      },
      "required": ["bindings"]
    }
  }
}
