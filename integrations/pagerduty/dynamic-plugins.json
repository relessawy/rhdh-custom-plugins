      "disabled": false,
      "pluginConfig": {
        "dynamicPlugins": {
          "frontend": {
            "pagerduty.backstage-plugin": {
              "entityTabs": [
                {
                  "path": "/pagerduty",
                  "title": "PagerDuty",
                  "mountPoint": "entity.page.pagerduty"
                }
              ],
              "mountPoints": [
                {
                  "mountPoint": "entity.page.pagerduty/cards",
                  "importName": "EntityPagerDutyCard",
                  "config": {
                    "props": {
                      "readOnly": true,
                      "disableChangeEvents": true
                    },
                    "layout": {
                      "gridColumn": "1 / -1"
                    },
                    "if": {
                      "allOf": [
                        "isPluginApplicableToEntity"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "package": "oci://ghcr.io/redhat-developer/rhdh-plugin-export-overlays/pagerduty-backstage-plugin-backend@sha256:c2d665dd21a464d6490f2c4249fcadf6f2f76fc555a71447f12c7527d4881609!pagerduty-backstage-plugin-backend",
      "disabled": false
    }
  ]
}
